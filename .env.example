# Server
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL connection string (required for ad checkout/verify features)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/downwind_paddling

# Public URL of the React app (used for Stripe redirect URLs)
APP_URL=http://localhost:5173

# API URL used by the Vite dev proxy (client reads this via vite.config)
API_URL=http://localhost:3001
CLIENT_PORT=5173

# Local directory for uploaded ad banner images
UPLOADS_DIR=./server/uploads

# Stripe secret key (optional — required only for /advertise checkout)
# STRIPE_SECRET_KEY=sk_test_...
