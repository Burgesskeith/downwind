{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": [
      "server/**",
      "lib/api-zod/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "Dockerfile",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node server/dist/index.cjs",
    "healthcheckPath": "/api/healthz",
    "restartPolicyType": "ON_FAILURE"
  }
}
